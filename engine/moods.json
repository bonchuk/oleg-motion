    "roles": {
      "subject": [{ "type": "float", "ampY": 6, "cycles": 1 }],
      "text": [{ "type": "breathe", "amp": 0.012, "cycles": 1 }]
    },
    "overlays": [{ "type": "particles", "kind": "dust", "count": 35, "direction": "float", "z": "front", "keepOut": ["price", "legal"] }]
  },
